# Web stack sources use LF. Delphi sources (*.pas, *.dfm, *.dpr, *.dpk) keep their
# native Windows (CRLF / windows-1252) encoding and are intentionally not normalized here.
*.sh   text eol=lf
*.cs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
